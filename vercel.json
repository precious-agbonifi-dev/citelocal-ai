{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(?:index\\.html)?",
      "dest": "/public/index.html"
    },
    {
      "src": "/api/robots-check",
      "dest": "/app.py"
    }
  ]
}
